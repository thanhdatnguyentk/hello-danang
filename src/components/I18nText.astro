---
import type { LocalizedString } from '../data/danang';

interface Props {
  t: LocalizedString;
  tag?: 'span' | 'p' | 'div' | 'h1' | 'h2' | 'h3';
  class?: string;
}

const { t, tag: Tag = 'span', class: className = '' } = Astro.props;
---

<Tag class={className}>
  <span data-i18n-lang="vi">{t.vi}</span>
  <span data-i18n-lang="en">{t.en}</span>
  <span data-i18n-lang="ja">{t.ja}</span>
</Tag>
