---
import { timeline24h, uiText } from '../data/danang';
import I18nText from './I18nText.astro';
---

<section class="timeline-section" id="itinerary">
  <div class="container">
    <div class="section-header">
      <div class="cute-pill-tag">
        <I18nText t={uiText.timelineSection.tag} />
      </div>
      <h2 class="section-title">
        <I18nText t={uiText.timelineSection.title} />
      </h2>
      <p class="section-subtitle">
        <I18nText t={uiText.timelineSection.subtitle} />
      </p>
    </div>

    <div class="timeline-list">
      {timeline24h.map((stop) => (
        <div class={`timeline-item timeline-item--${stop.period}`}>
          <div class="timeline-item__time-badge">
            <span class="time-clock">{stop.time}</span>
            <span class="time-tag">
              <I18nText t={stop.badge} />
            </span>
          </div>

          <div class="timeline-item__card">
            <h3 class="timeline-item__title">
              <I18nText t={stop.title} />
            </h3>
            <p class="timeline-item__place">
              <I18nText t={stop.place} />
            </p>
            <p class="timeline-item__desc">
              <I18nText t={stop.description} />
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-section {
    padding: 72px 0;
  }

  .timeline-list {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 22px;
    align-items: stretch;
  }

  .timeline-item__time-badge {
    background: var(--pastel-yellow);
    color: #1e2e3e;
    border: var(--border-cute);
    border-radius: var(--radius-lg);
    padding: 18px;
    box-shadow: var(--shadow-cute-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 6px;
  }

  .timeline-item--morning .timeline-item__time-badge {
    background: var(--pastel-blue-soft);
  }

  .timeline-item--afternoon .timeline-item__time-badge {
    background: var(--pastel-mint);
  }

  .timeline-item--night .timeline-item__time-badge {
    background: var(--pastel-pink);
  }

  .time-clock {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
  }

  .time-tag {
    font-size: 13px;
    font-weight: 700;
  }

  .timeline-item__card {
    background: var(--bg-card);
    border: var(--border-cute);
    border-radius: var(--radius-lg);
    padding: 22px 26px;
    box-shadow: var(--shadow-cute-sm);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.25s var(--bounce-ease);
  }

  .timeline-item__card:hover {
    transform: translateX(6px);
  }

  .timeline-item__title {
    font-family: var(--font-display);
    font-size: 21px;
  }

  .timeline-item__place {
    font-size: 14px;
    font-weight: 700;
    color: var(--pastel-blue);
  }

  .timeline-item__desc {
    font-size: 15px;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .timeline-item__time-badge {
      flex-direction: row;
      justify-content: space-between;
      padding: 12px 18px;
    }
  }
</style>
