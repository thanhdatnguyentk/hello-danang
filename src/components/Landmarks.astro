---
import { landmarks, uiText } from '../data/danang';
import I18nText from './I18nText.astro';
import LandmarkVisual from './LandmarkVisual.astro';
---

<section class="landmarks-section" id="landmarks">
  <div class="container">
    <div class="section-header">
      <div class="cute-pill-tag">
        <I18nText t={uiText.landmarksSection.tag} />
      </div>
      <h2 class="section-title">
        <I18nText t={uiText.landmarksSection.title} />
      </h2>
      <p class="section-subtitle">
        <I18nText t={uiText.landmarksSection.subtitle} />
      </p>
    </div>

    <div class="landmarks-grid">
      {landmarks.map((item) => (
        <article class={`landmark-card landmark-card--${item.accentColor}`}>
          <div class="landmark-card__top">
            <span class="landmark-card__num">{item.number}</span>
            <span class="landmark-card__badge">
              <I18nText t={item.badge} />
            </span>
          </div>

          <div class="landmark-card__visual">
            <LandmarkVisual type={item.visualType} />
          </div>

          <div class="landmark-card__body">
            <h3 class="landmark-card__title">
              <I18nText t={item.name} />
            </h3>
            <p class="landmark-card__sub">
              <I18nText t={item.subtitle} />
            </p>
            <p class="landmark-card__desc">
              <I18nText t={item.description} />
            </p>

            <div class="landmark-card__meta">
              <div class="meta-row">
                <strong><I18nText t={uiText.landmarksSection.bestTimeLabel} /></strong>
                <span><I18nText t={item.bestTime} /></span>
              </div>
              <div class="meta-row">
                <span>📍 <I18nText t={item.location} /></span>
              </div>
            </div>

            <div class="landmark-card__tip">
              <I18nText t={item.cuteTip} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .landmarks-section {
    padding: 72px 0;
  }

  .landmarks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .landmark-card {
    background: var(--bg-card);
    border: var(--border-cute);
    border-radius: var(--radius-xl);
    padding: 22px;
    box-shadow: var(--shadow-cute);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.28s var(--bounce-ease), box-shadow 0.28s var(--bounce-ease);
  }

  .landmark-card:hover {
    transform: translateY(-7px) rotate(-0.5deg);
    box-shadow: var(--shadow-cute-hover);
  }

  .landmark-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .landmark-card__num {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg-ocean-soft);
    border: 2px solid #1e2e3e;
    color: var(--ink-navy);
  }

  .landmark-card__badge {
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    border: 2px solid #1e2e3e;
    color: #1e2e3e;
    background: var(--pastel-yellow);
  }

  .landmark-card--blue .landmark-card__badge {
    background: var(--pastel-blue-soft);
  }

  .landmark-card--mint .landmark-card__badge {
    background: var(--pastel-mint);
  }

  .landmark-card--pink .landmark-card__badge {
    background: var(--pastel-pink);
  }

  .landmark-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .landmark-card__title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.25;
  }

  .landmark-card__sub {
    font-size: 14px;
    font-weight: 700;
    color: var(--pastel-blue);
  }

  .landmark-card__desc {
    font-size: 14.5px;
    color: var(--ink-muted);
    line-height: 1.65;
  }

  .landmark-card__meta {
    margin-top: auto;
    padding-top: 10px;
    border-top: 2px dashed rgba(104, 184, 248, 0.35);
    font-size: 13px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .landmark-card__tip {
    background: var(--bg-ocean-soft);
    border-radius: 16px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .landmarks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .landmarks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
