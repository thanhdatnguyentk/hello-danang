---
import { uiText } from '../data/danang';
import I18nText from './I18nText.astro';
---

<footer class="postcard-section" id="postcard">
  <div class="container">
    <div class="postcard">
      <!-- Cute Postage Stamp Corner -->
      <div class="postcard__stamp" aria-hidden="true">
        <span class="stamp-icon">🐉</span>
        <span class="stamp-city">ĐÀ NẴNG • VN</span>
      </div>

      <div class="cute-pill-tag">
        <I18nText t={uiText.postcardSection.tag} />
      </div>

      <h2 class="postcard__title">
        <I18nText t={uiText.postcardSection.title} />
      </h2>

      <p class="postcard__msg">
        <I18nText t={uiText.postcardSection.message} />
      </p>

      <div class="postcard__actions">
        <button type="button" class="cute-btn cute-btn--pink" id="send-love-btn">
          <I18nText t={uiText.postcardSection.sendLoveBtn} />
          <span class="love-counter" id="love-count-badge">143</span>
        </button>

        <a href="#top" class="cute-btn cute-btn--blue">
          <I18nText t={uiText.postcardSection.backToTop} />
        </a>
      </div>
    </div>

    <div class="footer-credit">
      <p>
        🐉 <strong>Hello Đà Nẵng!</strong> · Crafted with 💖 by
        <a href="https://github.com/thanhdatnguyentk" target="_blank" rel="noopener noreferrer">
          Nguyễn Thành Đạt (@thanhdatnguyentk)
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .postcard-section {
    padding: 56px 0 64px;
  }

  .postcard {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 44px 36px;
    background: var(--bg-card);
    border: var(--border-cute);
    border-radius: 36px;
    box-shadow: var(--shadow-cute);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(104, 184, 248, 0.08) 0px,
      rgba(104, 184, 248, 0.08) 12px,
      transparent 12px,
      transparent 24px
    );
  }

  .postcard__stamp {
    position: absolute;
    top: 22px;
    right: 24px;
    padding: 8px 12px;
    background: var(--pastel-yellow);
    color: #1e2e3e;
    border: 2.5px dashed #1e2e3e;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: rotate(6deg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
  }

  .stamp-icon {
    font-size: 22px;
  }

  .postcard__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.8vw, 38px);
    max-width: 640px;
    line-height: 1.2;
  }

  .postcard__msg {
    max-width: 640px;
    font-size: 16px;
    color: var(--ink-muted);
    line-height: 1.75;
  }

  .postcard__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }

  .love-counter {
    background: #ffffff;
    color: #e11d48;
    border: 2px solid #1e2e3e;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 13px;
  }

  .footer-credit {
    margin-top: 32px;
    text-align: center;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .footer-credit a {
    color: var(--pastel-blue);
    text-decoration: underline;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .postcard {
      padding: 32px 20px;
    }
    .postcard__stamp {
      position: static;
      transform: none;
    }
  }
</style>
